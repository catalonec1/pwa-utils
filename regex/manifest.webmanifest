{
  "id": "./",
  "name": "Stelar Regex Tester",
  "short_name": "Regex",
  "description": "Offline JavaScript regex tester: live highlighting, capture groups, clear errors. EN/RO/RU. Pro adds replace preview, pattern explanation, 34-pattern library, saved patterns, tests, CSV/JSON export.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#9c36b5",
  "categories": [
    "developer tools",
    "utilities",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stelar Regex Tester"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "412x915",
