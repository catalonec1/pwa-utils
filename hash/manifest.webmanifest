{
  "id": "./",
  "name": "Stelar Hash Generator",
  "short_name": "Hash",
  "description": "Offline hash generator: SHA-256, SHA-1, SHA-384, SHA-512, MD5 and CRC32 of text, hex or Base64, compare hashes. Pro: hash and verify files, SHA256SUMS lists, HMAC, batch lines, CSV.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#a61e4d",
  "categories": [
    "developer tools",
    "utilities",
    "security"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stelar Hash Generator"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Stelar Hash Generator"
    }
  ]
