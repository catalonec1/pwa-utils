{
  "id": "./",
  "name": "Stelar SQL Formatter",
  "short_name": "SQL Format",
  "description": "Offline Oracle SQL formatter: clause line breaks, indentation, keyword case, comma style, minify and highlighting; comments kept. Pro adds PL/SQL indentation, script split and code strings.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#364fc7",
  "categories": [
    "developer tools",
    "utilities",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stelar SQL Formatter"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Stelar SQL Formatter"
    }
  ]
}
