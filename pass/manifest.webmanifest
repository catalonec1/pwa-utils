{
  "id": "./",
  "name": "Stelar Password Generator",
  "short_name": "Passwords",
  "description": "Offline password generator: strong random passwords, strength meter and a private password check. In English, Romanian and Russian. Pro adds passphrases, PINs, easy-to-say passwords, lists of up to 500 and CSV export.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#7048e8",
  "categories": [
    "security",
    "utilities",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stelar Password Generator"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Stelar Password Generator"
    }
  ]
}
