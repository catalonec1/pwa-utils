{
  "id": "./",
  "name": "Stelar Color Converter",
  "short_name": "Colors",
  "description": "Offline color converter: HEX, RGB, HSL, HWB, CMYK, color picker and WCAG contrast checker. Pro adds palettes, OKLCH and LAB, CSS color names, saved palettes with export and colorblind previews.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#c2255c",
  "categories": [
    "developer tools",
    "utilities",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1366x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stelar Color Converter"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Stelar Color Converter"
    }
  ]
}
